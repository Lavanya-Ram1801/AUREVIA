# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://aurevia:aurevia@localhost:5432/aurevia?schema=public"
# Separate database used ONLY by `npm test` (tests wipe its tables). Its name must contain "test".
# Create it once and migrate it:  createdb aurevia_test  &&  DATABASE_URL=<this url> npx prisma migrate deploy
TEST_DATABASE_URL="postgresql://aurevia:aurevia@localhost:5432/aurevia_test?schema=public"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
JWT_EXPIRES_IN_HOURS=168

# --- Server ---
NODE_ENV=development
PORT=4000
# Exact origin of the frontend (used for CORS and reset links)
CLIENT_ORIGIN="http://localhost:5173"
# Cookie settings. In production over HTTPS keep COOKIE_SECURE=true.
# If the frontend and API are on different sites, use COOKIE_SAMESITE=none (requires secure).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Email (optional). Without SMTP_HOST, emails are printed to the server console in development. ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AUREVIA <no-reply@example.com>"

# --- Seed / admin provisioning ---
# Password given to the demo student & instructor accounts created by `npm run db:seed`.
SEED_PASSWORD="ChangeMe-Demo-123"
# Used only by `npm run admin:create` (never committed with real values).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Platform Admin"
